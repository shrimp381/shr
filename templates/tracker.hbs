<section class="shr-tracker {{#if tidy}}shr-tidy{{/if}} {{#if pinned}}shr-pinned{{/if}}" data-actor-uuid="{{actorUuid}}">
  <header class="shr-head">
    <h3 class="shr-title"><i class="fa-solid fa-heart-crack"></i> {{localize "SHR.Tracker.Wounds"}}</h3>
    <span class="shr-penalty {{#if count}}active{{/if}}" data-tooltip="{{localize "SHR.Tracker.PenaltyHint"}}" aria-label="{{localize "SHR.Tracker.Penalty"}}">
      <span class="shr-penalty-value">&minus;{{count}}</span>
    </span>
    {{#if pinnable}}
    <button type="button" class="shr-icon shr-pin {{#if pinned}}on{{/if}}" data-shr-action="pin" aria-pressed="{{#if pinned}}true{{else}}false{{/if}}"
      data-tooltip="{{#if pinned}}{{localize "SHR.Tracker.Unpin"}}{{else}}{{localize "SHR.Tracker.Pin"}}{{/if}}">
      <i class="{{#if pinned}}fa-solid{{else}}fa-regular{{/if}} fa-bookmark"></i>
    </button>
    {{/if}}
    {{#if editable}}
    <span class="shr-head-controls">
      <button type="button" class="shr-icon" data-shr-action="roll" data-tooltip="{{localize "SHR.Tracker.RollWound"}}"><i class="fa-solid fa-dice"></i></button>
      <button type="button" class="shr-icon" data-shr-action="add" data-tooltip="{{localize "SHR.Tracker.AddWound"}}"><i class="fa-solid fa-plus"></i></button>
    </span>
    {{/if}}
  </header>

  {{#if pending}}
  <div class="shr-pending">
    <span><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SHR.Tracker.Pending"}}</span>
    {{#if editable}}
    <button type="button" data-shr-action="permSave" data-pending-id="{{pending.id}}">{{localize "SHR.Tracker.RollSave"}} (DC {{pending.dc}})</button>
    {{/if}}
  </div>
  {{/if}}

  <ul class="shr-wounds">
    {{#each wounds}}
    <li class="shr-wound {{#if permanent}}permanent{{/if}} {{#if suppressed}}suppressed{{/if}}" data-wound-id="{{id}}">
      <img class="shr-wound-img" src="{{img}}" alt="">
      <div class="shr-wound-body" data-shr-action="expand">
        <div class="shr-wound-name">
          {{name}}{{#if instance}} <span class="shr-instance">&times;{{instance}}</span>{{/if}}
          <span class="shr-chip {{#if permanent}}perm{{else}}temp{{/if}}">{{#if permanent}}{{localize "SHR.Tracker.Permanent"}}{{else}}{{localize "SHR.Tracker.Temporary"}}{{/if}}</span>
          {{#if suppressed}}<span class="shr-chip sup" data-tooltip="{{localize "SHR.Tracker.SuppressedHint"}}">{{localize "SHR.Tracker.Suppressed"}}</span>{{/if}}
        </div>
        {{#if text}}<div class="shr-wound-text">{{text}}</div>{{/if}}
        {{#if note}}<div class="shr-wound-note">{{note}}</div>{{/if}}
      </div>
      {{#if ../editable}}
      <div class="shr-wound-controls">
        {{#unless permanent}}
        <button type="button" class="shr-icon" data-shr-action="treat" data-tooltip="{{localize "SHR.Tracker.Treat"}}"><i class="fa-solid fa-kit-medical"></i></button>
        <button type="button" class="shr-icon" data-shr-action="suppress" data-tooltip="{{#if suppressed}}{{localize "SHR.Tracker.Unsuppress"}}{{else}}{{localize "SHR.Tracker.Suppress"}}{{/if}}"><i class="fa-solid {{#if suppressed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
        {{/unless}}
        <button type="button" class="shr-icon danger" data-shr-action="remove" data-tooltip="{{localize "SHR.Tracker.Remove"}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/if}}
    </li>
    {{else}}
    <li class="shr-empty">{{localize "SHR.Tracker.NoWounds"}}</li>
    {{/each}}
  </ul>

  <div class="shr-armour">
    <h4 class="shr-subtitle"><i class="fa-solid fa-shield-halved"></i> {{localize "SHR.Tracker.Armour"}}</h4>
    {{#if exempt}}<p class="shr-exempt">{{exempt}}</p>{{/if}}
    {{#each armour}}
    <div class="shr-piece {{#if broken}}broken{{/if}}" data-item-id="{{id}}">
      <img class="shr-piece-img" src="{{img}}" alt="">
      <div class="shr-piece-body">
        <div class="shr-piece-name">{{name}}{{#if bonus}} <span class="shr-bonus">+{{bonus}}</span>{{/if}}</div>
        <div class="shr-pips" data-tooltip="{{cur}} / {{base}}">
          {{#each pips}}<span class="shr-pip {{#if on}}on{{/if}}"></span>{{/each}}
          <span class="shr-ac">{{cur}}/{{base}}</span>
          {{#if broken}}<span class="shr-chip broken">{{localize "SHR.Armour.Broken"}}</span>{{/if}}
        </div>
        {{#if rate}}<div class="shr-rate">{{rate}}</div>{{/if}}
      </div>
      {{#if ../editable}}{{#if canRepair}}
      <button type="button" class="shr-small" data-shr-action="repair">{{repairLabel}}</button>
      {{/if}}{{/if}}
    </div>
    {{else}}
    <p class="shr-empty">{{localize "SHR.Tracker.NoArmour"}}</p>
    {{/each}}
    {{#if shieldBlock}}
    <button type="button" class="shr-block" data-shr-action="shieldBlock">
      <i class="fa-solid fa-shield-halved"></i> {{localize "SHR.Tracker.ShieldBlock"}} <span class="hint">({{shieldBlock.amount}} &rarr; +{{shieldBlock.refund}} HP)</span>
    </button>
    {{/if}}
  </div>
</section>
